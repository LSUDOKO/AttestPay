pragma solidity ^0.8.24;

/// @title Real Attestcoin prover-API output, captured as test fixtures
/// @notice These are NOT hand-built blobs. Each is the exact `txBytes` string the live
/// proof generator at prover.cc3-testnet.creditcoin.network returned for a real
/// Ethereum Sepolia transaction, fetched via
/// `GET /api/v1/proof-by-tx/1/<txHash>`.
///
/// Why this file exists: `ProvenTxDecoder` decodes an encoding defined by someone
/// else's SDK. A test that feeds it a blob built by this repo's own encoder proves only
/// that the repo is self-consistent — it would pass just as happily if the encoding had
/// been misread. Decoding real wire bytes is what actually establishes that the
/// on-chain decoder will work against the live protocol.
///
/// Two transaction types are captured because the chunk layout differs by type and the
/// decoder's "receipt is always the last chunk" rule has to hold for both:
///   type 0x2 (EIP-1559) and type 0x0 (legacy).
library RealProofFixtures {
    /// Real `txBytes` from the Attestcoin prover API for Sepolia tx
    /// 0xb772a8df5f5604b7689477edccff797d8df7b5133162284b6fef82a03c51de55
    /// (block 11688140, txIndex 3, 5 receipt logs,
    ///  7 Merkle siblings, 1 continuity root(s)).
    function type2Tx() internal pure returns (bytes memory) {
        return hex"";
    }

    function type2TxLogs() internal pure returns (uint256) {
        return 5;
    }

    /// Real `txBytes` from the Attestcoin prover API for Sepolia tx
    /// 0x71ff7459dede6e24034d1fed5d16932f94f2b8e12c90420d1b7dd34fa525c816
    /// (block 11688140, txIndex 23, 9 receipt logs,
    ///  7 Merkle siblings, 1 continuity root(s)).
    function type0Tx() internal pure returns (bytes memory) {
        return hex"";
    }

    function type0TxLogs() internal pure returns (uint256) {
        return 9;
    }
}
