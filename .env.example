# attestpay server (packages/server)
ATTESTPAY_MASTER_KEY=          # required: 64 hex chars (32 bytes); encrypts agent keys + card secrets at rest
ATTESTPAY_ADMIN_TOKEN=         # ops lane: bearer token with FULL access to the management API (/api/*) — server-side curl/scripts only
ATTESTPAY_PRIVY_APP_ID=        # dashboard lane: enables per-user auth (Privy access tokens verified against this app's JWKS)
PORT=4070
ATTESTPAY_DB_PATH=.dev/attestpay.sqlite
ATTESTPAY_RPC_URL=https://mainnet.base.org
ATTESTPAY_PUBLIC_MCP_BASE=     # public origin used when rendering card URLs, e.g. https://api.example.com (also arms the MCP Host allowlist; unset = localhost)
ATTESTPAY_ALLOWED_HOSTS=       # extra Host headers accepted on /mcp + /c/<secret>/mcp (comma-separated)
ATTESTPAY_CORS_ORIGINS=        # comma-separated allowed origins for the API, e.g. https://app.example.com
ATTESTPAY_DEV_USER_PK=         # dev only: server-custodied user key for the server-signed issuance lane
ATTESTPAY_FACILITATOR_BASE=    # x402 facilitator base URL (defaults to this server)
ATTESTPAY_SELLER_PAYTO=        # payout address for the built-in demo seller
ATTESTPAY_PAID_FETCH_ALLOW_LOCAL=  # set to 1 to let paid_fetch hit local/private hosts (dev only)
ATTESTPAY_STRIPE_WEBHOOK_SECRET=   # Stripe real-time auth webhook signing secret (test mode); unset = fiat leg disabled (503)
STRIPE_SECRET_KEY=             # Stripe TEST-mode secret key (sk_test_/rk_test_ ONLY; anything else is refused); enables the fiat trigger + card credential tools
ATTESTPAY_FIAT_SETTLEMENT=         # set to 1: approved Visa charges settle on-chain as real delegated USDC transfers to the settlement address
ATTESTPAY_SETTLEMENT_ADDRESS=      # settlement recipient for the fiat leg; defaults to the fee collector
ATTESTPAY_DASHBOARD_BASE=          # dashboard origin hosting the OAuth consent page, e.g. https://app.example.com (default http://localhost:4071)
# Optional tuning (defaults apply when unset; uncomment to override):
#ATTESTPAY_RECONCILE_INTERVAL_MS=300000   # stuck-pending-charge reconcile sweep interval, ms (0 disables)
#ATTESTPAY_FIAT_FEE_HEADROOM=0.02         # USDC reserved for the settlement fee in the authorization decision (settlement mode only; live relayer minFee ~0.011)
#ATTESTPAY_FIAT_SETTLE_INTERVAL_MS=60000  # unsettled fiat charge sweep interval, ms
#ATTESTPAY_MCP_RATE_LIMIT=240             # per-card MCP request ceiling per minute
#ATTESTPAY_MCP_BAD_SECRET_LIMIT=30        # per-IP bad-credential attempt ceiling per minute
#ATTESTPAY_OAUTH_ACCESS_TTL=3600          # OAuth access-token lifetime, seconds
#ATTESTPAY_OAUTH_REFRESH_TTL=2592000      # OAuth refresh-token lifetime, seconds (30 days)
#ATTESTPAY_OAUTH_REDIRECT_HOSTS=          # if set, restrict https redirect-uri hosts to this comma-separated allowlist (recommended in prod; loopback + custom schemes always allowed)
#ATTESTPAY_OAUTH_ACCEPTED_RESOURCES=      # extra RFC 8707 resource URIs still honored (legacy values during a base-URL migration; comma-separated)
#ATTESTPAY_OAUTH_REGISTER_LIMIT=10        # per-IP client-registration ceiling per minute
#ATTESTPAY_OAUTH_AUTHORIZE_LIMIT=30       # per-IP authorize-request ceiling per minute
#ATTESTPAY_OAUTH_TOKEN_LIMIT=60           # per-IP token/revoke-request ceiling per minute
#ATTESTPAY_TRUST_PROXY_HOPS=1             # trusted proxy hops for client-IP rate-limiting (Railway=1; CDN+Railway=2; 0 disables XFF trust)

# attestpay dashboard (packages/dashboard)
# The dashboard authenticates as the USER: every API call carries the Privy session
# token, verified server-side. No admin token ever reaches the browser.
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_CLIENT_ID=
NEXT_PUBLIC_ATTESTPAY_API=http://localhost:4070/api
NEXT_PUBLIC_BASE_RPC=https://mainnet.base.org

# OpenTelemetry (SigNoz)
#
# For local SigNoz (from casting.yaml):
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
#
# For SigNoz Cloud (https://signoz.io):
#   1. Get your ingestion key from SigNoz Cloud dashboard -> Settings -> Ingestion Settings
#   2. Set the endpoint to your region (us, us2, eu, etc.) and the ingestion key header:
#
# OTEL_EXPORTER_OTLP_ENDPOINT=https://ingest.us2.signoz.cloud
# OTEL_EXPORTER_OTLP_HEADERS=signoz-ingestion-key=YOUR_KEY_HERE
#
# All three exporters default to otlp when the endpoint is set.
# Uncomment to force them:
#OTEL_TRACES_EXPORTER=otlp
#OTEL_METRICS_EXPORTER=otlp
#OTEL_LOGS_EXPORTER=otlp
#ATTESTPAY_OTEL_DEBUG=0                              # set to 1 for verbose OTel SDK logs

# ---------------------------------------------------------------------------
# Attestcoin Protocol — cross-chain payment verification on Creditcoin
# ---------------------------------------------------------------------------
#
# OPTIONAL. Leave the three required values blank and AttestPay behaves exactly as
# it does without this integration: payments work, the dashboard works, and the
# cross-chain tools simply are not offered. The server logs which variables are
# missing at boot rather than failing silently.
#
# REQUIRED to enable (all three, or the integration stays off):
#   ATTESTPAY_PAYMENT_ANCHOR_ADDRESS   PaymentAnchor, on Ethereum Sepolia
#   ATTESTPAY_ASC_ADDRESS              AttestPayASC, on Creditcoin CC3 testnet
#   ATTESTPAY_ATTESTCOIN_PRIVATE_KEY   signer for BOTH legs (needs Sepolia ETH + tCTC)
#
# WHY ETHEREUM SEPOLIA AND NOT BASE
#
# AttestPay pays USDC on Base, but the Attestcoin protocol on CC3 testnet attests
# only two source chains. Confirm it yourself:
#
#   cast call 0x0000000000000000000000000000000000000fd3 "get_supported_chains()" \
#     --rpc-url https://rpc.cc3-testnet.creditcoin.network
#
# which decodes to chainKey 3 (Ethereum mainnet) and chainKey 1 (Ethereum Sepolia).
# Base is not attested, so a Base transaction cannot be proven into Creditcoin.
# PaymentAnchor therefore lives on Sepolia and records the Base payment's facts;
# that anchoring transaction is what gets proven. See docs/attestcoin-integration.md
# for exactly what the resulting proof does and does not establish.

ATTESTPAY_PAYMENT_ANCHOR_ADDRESS=
ATTESTPAY_ASC_ADDRESS=
ATTESTPAY_ATTESTCOIN_PRIVATE_KEY=

# Attestcoin source-chain key. 1 = Ethereum Sepolia (default), 3 = Ethereum mainnet.
# NOT an EVM chain id.
ATTESTPAY_ATTESTCOIN_CHAIN_KEY=1

# Source chain RPC (where PaymentAnchor is deployed).
ATTESTPAY_SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com

# Creditcoin CC3 testnet (chain id 102031). HTTP, not WebSocket: the USC SDK needs a
# JsonRpcApiProvider. tCTC for gas comes from the Creditcoin Discord faucet.
ATTESTPAY_CREDITCOIN_HTTP_RPC=https://rpc.cc3-testnet.creditcoin.network

# Attestcoin proof generator API.
ATTESTPAY_PROVER_API_URL=https://prover.cc3-testnet.creditcoin.network

# The proof worker. Attestation runs ~8 minutes behind Sepolia, so a 60s tick is
# plenty; each tick advances up to BATCH_SIZE rows by one state.
# Set the interval to 0 to stop the worker (payments queue but never verify).
ATTESTPAY_ATTESTCOIN_SWEEP_INTERVAL_MS=60000
ATTESTPAY_ATTESTCOIN_BATCH_SIZE=10

# Set to 0 to force the integration off even when everything above is filled in.
#ATTESTPAY_ATTESTCOIN_ENABLED=1

# Only for the deploy scripts in contracts/ (never read by the server):
#   PRIVATE_KEY                  deployer key
#   ATTESTPAY_ANCHORER_ADDRESS   the address the server anchors from; the ASC credits
#                                only this anchorer. Defaults to the deployer.
#   ETHERSCAN_API_KEY            optional, for --verify on Sepolia

# ---------------------------------------------------------------------------
# Attestcoin: credit lines, disputes, guarantees, passport (all optional)
# ---------------------------------------------------------------------------
#
# Each feature switches on when its contract address is set. Credit lines and
# disputes also need FactAnchor (the source-chain anchor they share). Deployment:
# contracts/script/Deploy.s.sol (DeployFactAnchor on Sepolia, DeployCredit on CC3 —
# see docs/attestcoin-integration.md for the CC3 `cast send --create` sequence).
ATTESTPAY_FACT_ANCHOR_ADDRESS=      # FactAnchor on the source chain (Sepolia)
ATTESTPAY_CREDIT_LINE_ADDRESS=      # AttestPayCreditLine on Creditcoin: enables credit lines
ATTESTPAY_LEDGER_ADDRESS=           # AttestPayLedger on Creditcoin: enables proven disputes + revocations
ATTESTPAY_GUARANTEE_ADDRESS=        # AttestPayGuarantee on Creditcoin: CTC bonds behind borrowers
ATTESTPAY_PASSPORT_ADDRESS=         # CreditPassport on Creditcoin: the composed on-chain passport + score

# The chain AttestPay's USDC payments settle on (8453 Base, 84532 Base Sepolia).
# Recorded in every anchor as `sourceChainId`; compared against the registry so
# health can say whether the payment chain is attested yet.
#ATTESTPAY_PAYMENT_CHAIN_ID=8453

# Chain key discovery. `auto` reads get_supported_chains() from the ChainInfo
# precompile at boot and adopts the key whose chain id matches ATTESTPAY_SEPOLIA_RPC;
# an unattested source chain then disables the worker loudly instead of queueing
# proofs that can never be generated. A numeric value is kept as configured and
# any disagreement with the registry is logged as a warning.
#ATTESTPAY_ATTESTCOIN_CHAIN_KEY=auto

#ATTESTPAY_PASSPORT_RATE_LIMIT=60   # public GET /passport/:address + POST /passport/verify, per IP per minute

# ---------------------------------------------------------------------------
# Webhooks, events, audit log
# ---------------------------------------------------------------------------
# Always on (rides the same sqlite database). Webhooks are created per user from the
# dashboard (Settings) or POST /api/webhooks; every delivery is signed with the
# webhook's secret (X-AttestPay-Signature: t=<unix>,v1=<hmac-sha256>) and retried
# with backoff (30s, 2m, 10m, 1h, 6h) before being marked dead.
#ATTESTPAY_WEBHOOK_INTERVAL_MS=15000   # delivery sweep interval, ms (0 disables delivery)
#ATTESTPAY_WEBHOOK_ALLOW_LOCAL=0       # set to 1 to allow http:// and private-network webhook URLs (dev only)
